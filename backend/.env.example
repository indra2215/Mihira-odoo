# ==============================================================================
# Backend Environment Configuration Template
# ==============================================================================

# Django Secret Key for cryptographic signing (override in production)
DJANGO_SECRET_KEY=dev-secret-key-change-in-production-12345

# Debug mode (1 = True for development, 0 = False for production)
DEBUG=1

# Allowed hosts for incoming API requests
ALLOWED_HOSTS=*

# PostgreSQL Database Configuration
DB_NAME=mihira
DB_USER=mihira
DB_PASS=mihira
DB_HOST=localhost
DB_PORT=5432

# Set to 1 to run with local SQLite database (no PostgreSQL required)
USE_SQLITE=0
