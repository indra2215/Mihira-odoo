# ==============================================================================
# Environment Configuration Template for Mihira Solar ERP
# Copy this file to '.env' and adjust values for your environment
# ==============================================================================

# Database Name in PostgreSQL
DB_NAME=mihira

# Database User in PostgreSQL
DB_USER=mihira

# Database Password in PostgreSQL
DB_PASS=mihira

# Database Hostname ('localhost' when running directly, 'db' inside Docker Compose)
DB_HOST=localhost

# Database Port (default PostgreSQL port: 5432)
DB_PORT=5432

# Set to 1 to run backend with local SQLite (no PostgreSQL required)
USE_SQLITE=0

# Django Secret Key for cryptographic signing (change in production)
DJANGO_SECRET_KEY=dev-secret-key-change-in-production

# Debug Mode (1 = True for local development, 0 = False for production)
DEBUG=1

# Allowed Hostnames for Django API requests
ALLOWED_HOSTS=*

# Next.js React Frontend: Base URL for Django REST API endpoints
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
